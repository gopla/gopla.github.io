---
interface Props {
  section: 'projects' | 'about' | 'experience' | 'now' | 'connect'
  track?: boolean
}
const { section, track = false } = Astro.props
---

<span
  class:list={['character-dock', { 'character-dock--timeline': track }]}
  data-character-stop={track ? undefined : section}
  data-character-track={track ? '' : undefined}
  data-character-state="inactive"
  aria-hidden="true"
>
  <span class="character-dock-grid"></span>
  <span
    class="character-dock-portal"
    data-character-portal
    data-character-phase="inactive"
  >
    <span class="character-portal-spark"></span>
  </span>
  {section === 'now' && (
    <svg
      class="character-dock-device"
      viewBox="0 0 12 16"
      width="24"
      height="32"
      shape-rendering="crispEdges"
    >
      <path d="M1 1h10v11H1zM4 12h4v2H4zM2 14h8v2H2z" fill="var(--soft)" />
      <path d="M3 3h6v6H3z" fill="var(--bg)" />
      <path d="M4 4h2v2H4zM7 7h1v1H7z" fill="var(--mint)" />
    </svg>
  )}
  <span class="character-dock-shadow"></span>
  <span class="character-dock-floor" data-character-floor></span>
</span>
